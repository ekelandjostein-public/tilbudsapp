// Datamodellen for tilbudsappen.
// Hver "model" blir en tabell i databasen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Firmaet som bruker appen (logo, timepris osv. brukes i tilbudet)
model Firma {
  id       Int      @id @default(autoincrement())
  navn     String
  orgnr    String?
  adresse  String?
  telefon  String?
  epost    String?
  timepris Float    @default(950) // eks. mva
  brukere  Bruker[]
}

// En som kan logge inn. Alle brukere i samme firma ser de samme kundene og tilbudene.
model Bruker {
  id          Int        @id @default(autoincrement())
  firma       Firma      @relation(fields: [firmaId], references: [id])
  firmaId     Int
  navn        String
  epost       String     @unique // lagres alltid med små bokstaver
  passordHash String // aldri selve passordet – se src/lib/passord.ts
  rolle       String     @default("ANSATT") // ADMIN (kan legge til brukere) | ANSATT
  opprettet   DateTime   @default(now())
  okter       Okt[]
  befaringer  Befaring[]
  godkjente   Tilbud[]
}

// En innlogging. Nettleseren får en tilfeldig nøkkel i en informasjonskapsel;
// her lagrer vi bare en «fingeravtrykk» (hash) av den.
model Okt {
  id        String   @id // SHA-256 av nøkkelen i informasjonskapselen
  bruker    Bruker   @relation(fields: [brukerId], references: [id], onDelete: Cascade)
  brukerId  Int
  opprettet DateTime @default(now())
  utloper   DateTime
}

// Kunden fagmannen er på befaring hos
model Kunde {
  id         Int        @id @default(autoincrement())
  navn       String
  adresse    String
  telefon    String?
  epost      String
  opprettet  DateTime   @default(now())
  befaringer Befaring[]
}

// Det som fylles inn på befaring
model Befaring {
  id                 Int      @id @default(autoincrement())
  kunde              Kunde    @relation(fields: [kundeId], references: [id])
  kundeId            Int
  dato               DateTime
  arbeidsbeskrivelse String
  opprettet          DateTime @default(now())
  opprettetAv        Bruker?  @relation(fields: [opprettetAvId], references: [id], onDelete: SetNull)
  opprettetAvId      Int?
  tilbud             Tilbud[]
}

// Tilbudet agenten foreslår og fagmannen godkjenner
model Tilbud {
  id           Int            @id @default(autoincrement())
  befaring     Befaring       @relation(fields: [befaringId], references: [id])
  befaringId   Int
  status       String         @default("UTKAST") // UTKAST | GODKJENT | SENDT | AKSEPTERT | AVSLATT
  begrunnelse  String? // agentens forklaring på prisen
  grunnlag     String? // JSON: hvilke fakturaer prisen bygger på + forutsetninger
  opprettet    DateTime       @default(now())
  godkjent     DateTime? // når fagmannen godkjente – blir tilbudsdatoen på PDF-en
  godkjentAv   Bruker?        @relation(fields: [godkjentAvId], references: [id], onDelete: SetNull)
  godkjentAvId Int?
  sendt        DateTime?
  linjer       Tilbudslinje[]
}

model Tilbudslinje {
  id          Int    @id @default(autoincrement())
  tilbud      Tilbud @relation(fields: [tilbudId], references: [id], onDelete: Cascade)
  tilbudId    Int
  type        String // ARBEID | MATERIELL | KJORING | ANNET
  beskrivelse String
  antall      Float
  enhet       String // timer, stk, meter ...
  enhetspris  Float // eks. mva
}

// Tidligere fakturaer (lest inn fra PDF) som agenten lærer priser fra
model Faktura {
  id                 Int            @id @default(autoincrement())
  fakturanr          String?
  dato               DateTime?
  kundenavn          String?
  arbeidsbeskrivelse String // kort oppsummering av jobben
  totalEksMva        Float
  filnavn            String
  raatekst           String // teksten hentet ut av PDF-en
  importert          DateTime       @default(now())
  linjer             Fakturalinje[]
}

model Fakturalinje {
  id          Int     @id @default(autoincrement())
  faktura     Faktura @relation(fields: [fakturaId], references: [id], onDelete: Cascade)
  fakturaId   Int
  type        String
  beskrivelse String
  antall      Float
  enhet       String
  enhetspris  Float
}
